{
  "name": "deepsearch-public",
  "version": "0.2.0",
  "private": false,
  "description": "Privacy-aware deep web search engine for discovering, correlating, and verifying publicly available information.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/server-fixed.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server-fixed.js",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^11.2.0",
    "cheerio": "^1.1.2",
    "fastify": "^5.6.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.107.1"
  }
}
