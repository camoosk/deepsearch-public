{
  "name": "deepsearch-public",
  "version": "0.1.0",
  "private": false,
  "description": "Privacy-aware deep web search engine for discovering, correlating, and verifying publicly available information.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "cheerio": "^1.1.2",
    "fastify": "^5.6.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
