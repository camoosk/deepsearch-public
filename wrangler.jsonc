{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "deepsearch-public",
  "main": "src/worker-v2.ts",
  "compatibility_date": "2026-09-06",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://camoosk.github.io",
    "SEARCH_PROVIDER": "searxng",
    "SEARXNG_URL": "https://searx.tiekoetter.com",
    "SEARXNG_FALLBACK_URLS": "https://searxng.website,https://search.pereira.is,https://searxng.site",
    "MAX_RESULTS": "10",
    "MAX_PAGE_BYTES": "150000",
    "FETCH_TIMEOUT_MS": "8000",
    "USER_AGENT": "DeepSearchPublic/0.5 (+https://github.com/camoosk/deepsearch-public)"
  }
}
